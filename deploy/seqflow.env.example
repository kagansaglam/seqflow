# Copy to /etc/seqflow/seqflow.env and restrict access: chmod 600, owner seqflow.
# It holds credentials; never commit the real file.
SEQFLOW_DB=postgresql+psycopg2://seqflow:CHANGE_ME@localhost:5432/seqflow

# Slack incoming webhook for errors and the digest (leave out to disable)
#SEQFLOW_SLACK_WEBHOOK=https://hooks.slack.com/services/...

# E-mail alerts need both SEQFLOW_SMTP_HOST and SEQFLOW_MAIL_TO
#SEQFLOW_SMTP_HOST=smtp.example.org
#SEQFLOW_SMTP_PORT=587
#SEQFLOW_SMTP_STARTTLS=1
#SEQFLOW_SMTP_USER=seqflow
#SEQFLOW_SMTP_PASSWORD=CHANGE_ME
#SEQFLOW_MAIL_FROM=seqflow@example.org
#SEQFLOW_MAIL_TO=lab-bioinfo@example.org,pi@example.org
